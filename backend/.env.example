# Backend local environment template
# Copy this file to backend/.env and fill values locally.
# Do not commit backend/.env.

# Server
PORT=8080

# Database
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_DRIVER=

# Anthropic Claude API - backend only
ANTHROPIC_API_KEY=

# Supabase server-side auth verification
# Do not use NEXT_PUBLIC_* names in the backend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# Temporary admin test auth
ADMIN_TEST_ID=
ADMIN_TEST_PASSWORD=
# Local development only; production defaults to the prod profile.
SPRING_PROFILES_ACTIVE=dev
ADMIN_TEST_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
AI_DAILY_LIMIT=20
AI_CONCURRENT_LIMIT=4
# For local H2 omit blank DATABASE_* entries, or configure PostgreSQL explicitly.
