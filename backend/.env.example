# Backend local environment template
# Copy this file to backend/.env and fill values locally.
# Do not commit backend/.env.

# Server
PORT=

# Database
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_DRIVER=

# Anthropic Claude API - backend only
ANTHROPIC_API_KEY=

# Supabase server-side auth verification
# Do not use NEXT_PUBLIC_* names in the backend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1

# Temporary admin test auth (development only). Disabled unless ADMIN_TEST_ENABLED=true.
# ADMIN_TEST_PASSWORD must be at least 12 characters or every admin login is rejected.
ADMIN_TEST_ENABLED=false
ADMIN_TEST_ID=
ADMIN_TEST_PASSWORD=

# Comma-separated exact browser origins allowed by CORS (no wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Premium plan (manual grant until billing exists)
# Comma-separated Supabase user IDs (JWT sub) allowed to call PUT /api/admin/users/{userId}/plan
PLAN_ADMIN_USER_IDS=
PREMIUM_MONTHLY_MINUTES=600

# Media uploads for audio/video minutes
MEDIA_DIR=./data/media
MEDIA_MAX_FILE_SIZE_MB=500
# Optional: needed only for webm/mov/mkv conversion
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Speech-to-text (RTZR / VITO OpenAPI) - backend only
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=

# Frontend origin used in Kakao message links and payment redirects
FRONTEND_BASE_URL=http://localhost:3000

# Toss Payments billing (subscription). Defaults are the public docs test keys test_ck_/test_sk_ (no real charges).
# Note: widget keys (test_gck_/test_gsk_) do not work for the billing API.
# Sign up at https://developers.tosspayments.com (email only, no business registration) for your own test keys.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
PREMIUM_PRICE_KRW=4900

# Kakao Developers app (https://developers.kakao.com): REST API key, Kakao Login enabled,
# redirect URI http://localhost:3000/kakao/callback registered, consent item "talk_message" enabled.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
DEADLINE_REMINDER_CRON=0 0 9 * * *

# Any long random string. Encrypts stored Kakao tokens with AES-GCM.
# Required when KAKAO_REST_API_KEY is set; the server refuses to start otherwise.
APP_TOKEN_ENCRYPTION_KEY=
